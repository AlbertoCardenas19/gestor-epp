# Ejemplo para una instancia PostgreSQL existente. No contiene credenciales reales.
# Copia a .env y adapta los valores. Django lo carga automáticamente.
# Las variables ya presentes en el proceso tienen prioridad sobre este archivo.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=django-insecure-local-development-only
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gestor_epp
PGUSER=gestor_epp
PGPASSWORD='reemplazar_por_la_clave_local'

# Si usas scripts/dev-db.sh en lugar de una instancia existente:
# PGHOST=/ruta/absoluta/al/repositorio/.local/pgsocket
# PGPORT=55432
# PGPASSWORD=''
